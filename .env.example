PORT=8080
POSTGRES_PASSWORD=local-db-password
WEB_DB_PASSWORD=local-web-password
WORKER_DB_PASSWORD=local-worker-password
# Seeded debate profiles use the more capable 3B model.
DEFAULT_MODEL=qwen2.5:3b
OLLAMA_MEMORY_LIMIT=4g
# Optional LM Studio / llama.cpp / other OpenAI-compatible endpoint:
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=
